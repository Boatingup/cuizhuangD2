QWidget#driver_chn_config
{
    background-color:#0A102A;

}

QLabel#title_label
{
    color:#808080;/* 前景色,可以写white */
    /*background:transparent;*/
    font:20pt; /* 字号 */
    margin:6px;/* 外边距 */
}

QHeaderView
{
    background:#00297F;
    border:none;
    color: white;

}

QTableView{
    border:none;
    color:#E0FFFF; /* 前景色即文字颜色 */
    background-color:#0A102A; /*交替显示中的深色*/
    alternate-background-color:#071341;/* 浅色 */
}

QTabWidget::tab-bar{
        border-width:0px;
        alignment:left;
        }

QTabBar::tab{
        border-bottom-color:#8A2BE2;
        border-top-left-radius: 0px;
        border-top-right-radius: 15px;
        min-width:100px;
        min-height:20px;
        color: rgb(255,255,255);
        background-color:#4169E1;
        font:18px #FFFFFF;
        padding: 0px;
        }

QTabBar::tab:!selected {
        margin-top: 5px;
        }

QTabBar::tab:selected {
        color: yellow;
        background-color: #00297F;
        }

